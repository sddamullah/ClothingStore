@model IEnumerable<ClothingStore.Models.Category>


 
<table class="table">
    <thead>
        <tr>
            <th class="sc-cell">
                @Html.DisplayNameFor(model => model.varName)
            </th>
            <th class="sc-cell">
                @Html.DisplayNameFor(model => model.varDescription)
            </th>
            <th class="sc-cell">
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th class="sc-cell">
                @Html.DisplayNameFor(model => model.dtCreatedDate)
            </th>
            <th class="sc-cell">
                @Html.DisplayNameFor(model => model.dtUpdatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.varName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.varDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActive)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.dtCreatedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.dtUpdatedDate)
            </td>
            <td>                
                    <img src="images/edit.png"  width="20" onclick="OpenEditCategoryPopup(@item.intSeqId)" height="20" title="Edit" style="cursor:pointer;" />
                    <img src="images/delete.png" width="20" onclick="Deletecatedory(@item.intSeqId)" height="20" title="Delete" style="cursor:pointer;" />
            </td>
        </tr>
}
    </tbody>
</table>
