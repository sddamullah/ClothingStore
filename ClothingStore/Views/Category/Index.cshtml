@{

    ViewData["Title"] = "Index";
}
@section Scripts
{
    <script src="~/js/category.js" asp-append-version="true"></script>
}              

 

<div class="sc-page">
    <div class="sc-panel">
        <div class="sc-panel__head">
            <div>
                <h2 class="sc-panel__title">Categories</h2>
                <p class="sc-panel__sub">Organize the collections your storefront is built from.</p>
            </div>
            <button type="button" class="sc-btn sc-btn--primary" onclick="OpenCategoryPopup()">
                <i class="fa-solid fa-plus"></i>
                Add Category
            </button>
        </div>
        
            <div id="CategoryGrid" class="sc-table sc-table-cont " style="--sc-cols: 44px 2fr 3fr 1fr 96px;">
                <div class="sc-table__empty">Loading…</div>
        </div>
    </div>

    <!-- Add Category -->
    <div id="categoryPopup" class="sc-popup">
        <div class="sc-popup__content">
            <div class="sc-popup__header">
                <div>
                    <h2>Add Category</h2>
                    <p>Fill in the details below.</p>
                </div>
                <button type="button"
                        class="sc-popup__close"
                        onclick="CloseCategoryPopup()">
                    &times;
                </button>
            </div>
            <div class="sc-popup__body">
                <div id="_Create">
                    Loading...
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Category -->
    <div id="editCategoryPopup" class="sc-popup">
        <div class="sc-popup__content">
            <div class="sc-popup__header">
                <div>
                    <h2>Edit Category</h2>
                    <p>Update the details below.</p>
                </div>
                <button type="button" class="sc-popup__close" onclick="CloseEditCategoryPopup()">&times;</button>
            </div>
            <div class="sc-popup__body">
                <div id="_Edit">
                    Loading...
                </div>
            </div>
        </div>
    </div>
</div>


 
