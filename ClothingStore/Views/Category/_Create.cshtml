@model ClothingStore.Models.Category
<form id="frmCreateCategory" class="sc-form">
    <div class="sc-form-row">
        <div class="sc-form-group">
            <label asp-for="varName">Category Name</label>
            <input asp-for="varName" class="sc-input" id="varName" placeholder="e.g. Outerwear" />
        </div>
        <div class="sc-form-group">
            <label>Status</label>
            <label class="sc-switch">
                <input type="checkbox" id="chkIsActive" checked />
                <span class="sc-slider"></span>
            </label>
        </div>
        <div class="sc-form-group sc-full" style="width:100%;">
            <label asp-for="varDescription">Description</label>
            <textarea id="varDescription" rows="5" class="sc-input" placeholder="What belongs in this category?"></textarea>
        </div>
    </div>
    <div class="sc-form-footer">
        <button type="button" id="btnSave" onclick="AddCategory()" class="sc-btn sc-btn--primary">
            <i class="fa-solid fa-floppy-disk"></i>
            Save Category
        </button>
    </div>
</form>
