@model ClothingStore.Models.Category
<form id="frmEditCategory" class="sc-form">
    <input type="hidden" id="editIntSeqId" value="@Model.intSeqId" />
    <div class="sc-form-row">
        <div class="sc-form-group">
            <label asp-for="varName">Category Name</label>
            <input asp-for="varName" class="sc-input" id="editVarName" value="@Model.varName" />
        </div>
        <div class="sc-form-group">
            <label>Status</label>
            <label class="sc-switch">
                <input type="checkbox" id="editChkIsActive" checked="@Model.IsActive" />
                <span class="sc-slider"></span>
            </label>
        </div>
        <div class="sc-form-group sc-full" style="width:100%;">
            <label asp-for="varDescription">Description</label>
            <textarea id="editVarDescription" rows="5" class="sc-input">@Model.varDescription</textarea>
        </div>
    </div>
    <div class="sc-form-footer">
        <button type="button" id="btnUpdate" onclick="UpdateCategory()" class="sc-btn sc-btn--primary">
            <i class="fa-solid fa-floppy-disk"></i>
            Update Category
        </button>
    </div>
</form>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
