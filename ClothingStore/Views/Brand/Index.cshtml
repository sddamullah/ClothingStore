@section Scripts
{
<script src="~/js/Brand.js" asp-append-version="true"></script>
}
@{
    ViewData["Title"] = "Brands";
}
 

<div class="sc-page">
    <div class="sc-panel">
        <div class="sc-panel__head">
            <div>
                <h2 class="sc-panel__title">Brand</h2>

            </div>
            <button type="button" class="sc-btn sc-btn--primary" onclick="OpenCreateBrandPopup()">
                <i class="fa-solid fa-plus"></i>
                Add Brand
            </button>
        </div>
        <div class="sc-table-cont ">


            <table class="sc-table ">
                <tr class="">
                    <th>Logo</th>
                    <th>Brand Name</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th>Action</th>
                </tr>
                <tbody id="brandGridContainer">
                    <tr>
                        <td colspan="100%" class="sc-table__empty" style="text-align:center">Loading…</td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>

 

 


    <div id="Brandpopup" class="sc-popup" style="display:none;">

        <div class="sc-popup__content">

            <div class="sc-popup__header">

                <h3>  Brand</h3>

                <button onclick="CloseBrandpopup()" class="sc-popup__close">
                    <i class="fa fa-times"></i>
                </button>

            </div>

            <div id="brandPopupContainer" class="sc-popup__body sc-form"></div>
            


        </div>

    </div>
</div>
