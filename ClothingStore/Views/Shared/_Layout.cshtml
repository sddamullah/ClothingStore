    <div class="sc-shell">

        <!-- Sidebar -->
        <aside class="sc-sidebar" id="scSidebar">
            <a class="sc-sidebar__brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-shirt"></i>
                ClothingStore
            </a>

            <ul class="sc-sidebar__nav">
                <li>
                    <a class="sc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "is-active" : "")"
                       asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-house"></i>
                        Home
                    </a>
                </li>
                <li>
                    <a class="sc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "is-active" : "")"
                       asp-area="" asp-controller="Category" asp-action="Index">
                        <i class="fa-solid fa-tags"></i>
                        Category
                    </a>
                </li>
                <li>
                    <a class="sc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "is-active" : "")"
                       asp-area="" asp-controller="Product" asp-action="Index">
                        <i class="fa-solid fa-shirt"></i>
                        Product
                    </a>
                </li>
            </ul>

            <div class="sc-sidebar__foot">&copy; @DateTime.Now.Year ClothingStore</div>
        </aside>

        <!-- Backdrop for mobile drawer -->
        <div class="sc-sidebar-backdrop" id="scSidebarBackdrop" onclick="ToggleSidebar(false)"></div>

        <!-- Main content -->
        <div class="sc-shell__content">
            <header class="sc-topbar">
                <button type="button" class="sc-topbar__toggle" onclick="ToggleSidebar()" aria-label="Toggle navigation">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <span class="sc-topbar__brand">ClothingStore</span>
            </header>

            <div class="container-fluid">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>

    </div>
   
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function ToggleSidebar(force) {
            const sidebar = document.getElementById('scSidebar');
            const isOpen = force !== undefined ? force : !sidebar.classList.contains('is-open');
            sidebar.classList.toggle('is-open', isOpen);
            document.body.classList.toggle('sc-sidebar-open', isOpen);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 
  

  